{% if test_mode %}
<div class="alert alert-info">{{ texts.test|e }}</div>
{% endif %}
<p>{{ texts.description|e }}</p>
<div class="text-end">
  <button type="button" id="button-confirm" class="btn btn-primary">{{ button_confirm|e }}</button>
</div>
<script type="text/javascript"><!--
$('#button-confirm').on('click', function () {
	var button = $(this);
	$.ajax({
		url: '{{ confirm_url }}',
		type: 'post',
		dataType: 'json',
		// Old stores on new PHP print notices before the answer: the JSON is taken from its end.
		dataFilter: function (text) {
			var start = text.lastIndexOf('{"');
			return start > 0 ? text.slice(start) : text;
		},
		beforeSend: function () {
			button.prop('disabled', true).text('{{ text_loading|e('js') }}');
		},
		success: function (json) {
			if (json['redirect']) {
				location = json['redirect'];
				return;
			}
			button.prop('disabled', false).text('{{ button_confirm|e('js') }}');
			if (json['error']) {
				alert(json['error']);
			}
		},
		error: function (xhr, ajaxOptions, thrownError) {
			button.prop('disabled', false).text('{{ button_confirm|e('js') }}');
			alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
		}
	});
});
//--></script>
