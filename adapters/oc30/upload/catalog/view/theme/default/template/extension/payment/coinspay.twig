{% if test_mode %}
<div class="alert alert-info">{{ texts.test|e }}</div>
{% endif %}
<p>{{ texts.description|e }}</p>
<div class="buttons">
  <div class="pull-right">
    <input type="button" value="{{ button_confirm|e }}" id="button-confirm" data-loading-text="{{ text_loading|e }}" class="btn btn-primary" />
  </div>
</div>
<script type="text/javascript"><!--
$('#button-confirm').on('click', function() {
	$.ajax({
		url: '{{ confirm_url }}',
		type: 'post',
		dataType: 'json',
		// Old stores on new PHP print notices before the answer: the JSON is taken from its end.
		dataFilter: function (text) {
			var start = text.lastIndexOf('{"');
			return start > 0 ? text.slice(start) : text;
		},
		beforeSend: function() {
			$('#button-confirm').button('loading');
		},
		success: function(json) {
			if (json['redirect']) {
				location = json['redirect'];
				return;
			}
			$('#button-confirm').button('reset');
			if (json['error']) {
				alert(json['error']);
			}
		},
		error: function(xhr, ajaxOptions, thrownError) {
			$('#button-confirm').button('reset');
			alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
		}
	});
});
//--></script>
